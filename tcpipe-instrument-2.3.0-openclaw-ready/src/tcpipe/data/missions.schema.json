{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "missions"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "missions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["mission_id", "track", "priority", "title", "blocks_production", "problem", "done_when"],
        "properties": {
          "mission_id": {"type": "string", "pattern": "^M-[0-9]{3}$"},
          "track": {"enum": ["legacy_integrity", "parsing_capability", "cross_track"]},
          "priority": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 4},
          "blocks_production": {"type": "boolean"},
          "problem": {"type": "string", "minLength": 10},
          "done_when": {"type": "string", "minLength": 10}
        }
      }
    }
  }
}
