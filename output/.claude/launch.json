{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "atbalsts-demo",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "atbalsts-radio-validation/demo/serve.py",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "cicada",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "cicada",
        "run",
        "dev"
      ],
      "port": 4137
    },
    {
      "name": "coordination-preview",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "-u",
        "TYPESAFE_API_KEY",
        "-u",
        "OPENROUTER_API_KEY",
        "JUDGMENT_ENGINE=rules",
        "PORT=8788",
        "DB=coordination-prototype/data/preview.db",
        "COORDINATOR_KEY=preview-only-key",
        "SESSION_SECRET=preview-only-secret",
        "node",
        "--experimental-sqlite",
        "--no-warnings",
        "coordination-prototype/run.js"
      ],
      "port": 8788
    }
  ]
}
