# Copy to .env — it is gitignored. Never commit the real file.
#
#   npm run env     (safe: refuses to overwrite an existing .env)
#
# Do not use `cp .env.example .env` once a key is in place; it clobbers it.
#
# The prototype runs fully without any of this: the rules fallback is the
# default engine, and every number in the README was measured on it. A key only
# swaps the judgment engine for the hosted model.

# The only credential that does anything here.
# From https://typesafe.ai/ — the System One API, POST /v1/systemone.
TYPESAFE_API_KEY=

# Which engine the judgment layer uses. Leave as rules to run without a key.
# Set to typesafe once TYPESAFE_API_KEY is filled in above. The hosted engine
# also needs the initiative's own permission — "hosted_processing": true in its
# config — and without it the rules engine answers as a degraded fallback that
# can triage but never bind. This switch chooses an engine; it cannot grant that.
JUDGMENT_ENGINE=rules

# Which model the hosted engine asks. jev-latest resolves to jev-1.13.0.
TYPESAFE_MODEL=jev-latest

# Point the judgment client somewhere else — a local mock, a proxy, a recorded
# replay, or the OpenRouter shim below. Leave unset for the real endpoint.
# TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone

# --- the OpenRouter shim, for when there is no TypeSafe key ----------------
# bin/openrouter-shim.js serves the System One contract on localhost and
# translates it into one OpenRouter chat completion. It is NOT Jev: a chat model
# asked for a probability reports a number it wrote, not a calibrated one, so
# read the calibration table before trusting any of it. Every answer it returns
# is stamped openrouter-shim.
#
#   node --env-file-if-exists=.env bin/openrouter-shim.js
#   TYPESAFE_ENDPOINT=http://localhost:8799/v1/systemone JUDGMENT_ENGINE=typesafe npm run accept
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# SHIM_PORT=8799

# --- inbound webhooks ------------------------------------------------------
# Unset means the webhook refuses everything (503): an unauthenticated webhook
# would let anyone post as anyone.
# TELEGRAM_WEBHOOK_SECRET=   # the secret_token given to Telegram's setWebhook
# EMAIL_WEBHOOK_SECRET=      # the mail relay signs the raw body: X-Signature: sha256=<hex hmac>

# --- the web prototype, not the judgment layer -----------------------------
# PORT=8787
# DB=data/coordination.db
# BASE_URL=http://localhost:8787
# COORDINATOR_KEY=      # the magic link printed at startup; set to keep it stable
# SESSION_SECRET=       # set to keep coordinator sessions across restarts
